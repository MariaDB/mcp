# Copy to .env and fill in your values:
#   cp .env.example .env

# --- Database (required) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_default_database

# --- MCP server ---
MCP_READ_ONLY=true
MCP_MAX_POOL_SIZE=10

# --- Optional: SSL/TLS ---
# DB_SSL=false
# DB_SSL_CA=
# DB_SSL_CERT=
# DB_SSL_KEY=
# DB_SSL_VERIFY_CERT=true
# DB_SSL_VERIFY_IDENTITY=false

# --- Optional: embeddings (pulls heavy deps; leave unset for SQL-only use) ---
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HF_MODEL=

# --- Docker on Mac/Windows: DB on the host (e.g. SSH tunnel on localhost) ---
# DB_HOST=host.docker.internal
